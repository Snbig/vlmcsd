          "partialFingerprints": {
            "primaryLocationLineHash": "ee2c34fac98b9ada53253f33cd51d7d5"
          },
          "properties": {
            "confidence": "high",
            "category": "information-disclosure",
            "technical_evidence": "src/kms.c:564 logger(\"Sending ePID (%s): %s\\n\", EpidSource, utf8pid); — full ePID in non-verbose log. src/kms.c:570 logResponseVerbose(utf8pid, hwId, baseResponse, &logger); src/output.c:230 p(\"KMS host extended PID           : %s\\n\", ePID); src/output.c:233 p(\"KMS host Hardware ID            : %016llX\\n\", ...); src/output.c:239 p(\"Client machine ID               : %s\\n\", guidBuffer);",
            "attack_or_trigger_condition": "An attacker who obtains the daemon log file (e.g. via log disclosure, backup leak, or shared logging infrastructure) can extract per-host identifiers for every activation event.",
            "impact": "Privacy/correlation risk: ePIDs and Hardware IDs are per-host unique identifiers; leaked logs enable tracking of activation activity and host fingerprinting.",
            "why_suspicious": "Logging unique per-host identifiers is a data-exfiltration-adjacent pattern, though here it is written to the local log only, not transmitted.",
            "benign_explanation": "Upstream Wind4 logging behavior; verbose logging is opt-in (-v). No network transmission of these values was found.",
            "recommended_action": "Redact or truncate ePID/Hardware ID in logs, or restrict log file permissions and treat logs as sensitive."
          }
        },
        {
          "ruleId": "SEC-AUDIT-004",
          "ruleIndex": 3,
          "level": "note",
          "message": {
            "text": "BUILD_TIME is hardcoded to 1538922811 (2018-10-07) as a fallback, clamping ePID timestamps; the surrounding comment still references 10/17/2013."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/kms.c"
